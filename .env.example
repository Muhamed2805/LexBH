# Copy this file to .env for local development. Never commit .env.
# The values below are safe defaults for a local database only.

# --- Application settings -------------------------------------------------

# Deployment environment: local, test, staging, or production.
# Logs are JSON in every environment except local.
LEXBH_ENVIRONMENT=local

# Log level: DEBUG, INFO, WARNING, ERROR, or CRITICAL.
LEXBH_LOG_LEVEL=INFO

# Required. Must use the postgresql+asyncpg driver.
# Percent-encode special characters in the password.
# This URL is for tools running on the host. The api container builds its own URL.
LEXBH_DATABASE_URL=postgresql+asyncpg://lexbh:lexbh_local_dev@127.0.0.1:5433/lexbh

# Connections kept open in the pool (minimum 1).
LEXBH_DATABASE_POOL_SIZE=5

# Extra connections allowed above the pool size (minimum 0).
LEXBH_DATABASE_MAX_OVERFLOW=10

# Seconds GET /ready waits for the database before returning 503.
LEXBH_READINESS_TIMEOUT_SECONDS=2.0

# --- Docker Compose database credentials ----------------------------------

# Used by the db service and to build the api container's database URL.
# Keep these in step with LEXBH_DATABASE_URL above.
POSTGRES_USER=lexbh
POSTGRES_PASSWORD=lexbh_local_dev
POSTGRES_DB=lexbh
